# Code PIN d'accès historique (routes /api/auth/login et /api/auth/session).
# N'autorise plus aucune route sensible : ne le réutilisez jamais comme secret.
CRM_ACCESS_PIN=1234
# Optionnel : secret de session (sinon le PIN sert de secret).
# CRM_SESSION_SECRET=changez-moi-en-production

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clés dans Supabase → Project Settings → API (anon/public + service_role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLIQUE_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_supabase

# Référence du projet de production, c'est-à-dire la partie <REF> de l'URL
# ci-dessus. Ce n'est pas un secret : elle figure déjà dans l'URL publique.
# À poser dans les TROIS environnements Vercel, avec la même valeur. C'est ce
# qui permet de refuser un déploiement Preview qui viserait la production : la
# compilation échoue, et le déploiement n'existe donc jamais.
# Sans elle, ce contrôle est inactif et le build émet un avertissement.
SUPABASE_PRODUCTION_REF=VOTRE-PROJET
# OBLIGATOIRE : sel secret de hachage des PIN. Sans elle, aucun PIN ne peut être
# créé (invitation, réinitialisation, activation). Valeur longue et aléatoire,
# distincte de la clé service. La changer invalide tous les PIN existants.
ACTIVATION_PIN_PEPPER=secret-aleatoire-pour-hacher-les-pin
# Secret pour créer le 1er admin via POST /api/auth/initial-setup (une seule
# fois) et pour la route de secours POST /api/auth/issue-pin. 24 caractères mini.
INITIAL_SETUP_SECRET=secret-setup-initial-au-moins-24-caracteres

# Envoi email OVH (recommandé pour contact@mkl-energies.fr)
MAIL_SMTP_HOST=ssl0.ovh.net
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=contact@mkl-energies.fr
MAIL_SMTP_PASSWORD=mot_de_passe_de_la_boite_mail
MAIL_FROM=MKL Energies <contact@mkl-energies.fr>

# Alternative : API Resend (si vous n'utilisez pas OVH SMTP)
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_TOKEN=re_xxxxxxxx

# Domaine canonique de production. En Preview, omettre cette variable permet
# aux liens d'invitation d'utiliser automatiquement l'URL du déploiement.
APP_PUBLIC_URL=https://crm.mkl-energies.fr

# Google Solar API (optionnel — étude d’installation photovoltaïque complète)
# Console Google Cloud → activer Solar API → clé. Sert aux pans, à l’ombrage et à la carte de chaleur.
# Sans clé, PVGIS + photo IGN.
# GOOGLE_SOLAR_API_KEY=

# Google Calendar (OAuth officiel — jamais le mot de passe Google)
# Console : https://console.cloud.google.com → APIs & Services → Credentials
# Activer Google Calendar API
# Redirect URI : https://VOTRE-DOMAINE/api/google/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm-mkl-energeies.vercel.app/api/google/calendar/callback
# Chiffrement des jetons OAuth (fallback : ACTIVATION_PIN_PEPPER / CRM_SESSION_SECRET)
# CRM_SESSION_SECRET=

# Secret du cron Vercel (rappel agenda quotidien 07:00 UTC ; les rappels CRM sont aussi calculés à l’ouverture de la cloche)
CRON_SECRET=

# Réception des demandes signées du site mkl-energies.fr (appel de serveur à
# serveur depuis OVH). Trousseau au format `identifiant:secret`, séparé par des
# virgules, pour pouvoir changer de secret sans interruption. Secret de 32
# caractères minimum, généré aléatoirement, jamais partagé avec le navigateur.
# WEB_LEAD_KEYRING=k1:secret-aleatoire-de-32-caracteres-minimum

