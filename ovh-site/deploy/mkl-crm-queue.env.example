# Configuration du déclencheur de file, à installer en /etc/mkl/crm-queue.env
# avec les droits 0600 et le propriétaire mkl:mkl.
#
# Le secret n'est pas écrit dans le script, ni passé en argument : un argument
# apparaîtrait dans la liste des processus, visible par tout le système.

CRM_URL=https://crm.mkl-energies.fr
CRON_SECRET=
