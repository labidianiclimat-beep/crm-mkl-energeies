# Configuration du site mkl-energies.fr. Copier en `.env` — jamais commité.

PORT=4317

# Administration du site (voir lib/admin-auth.mjs)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Preuve de consentement pour les demandes de rappel (OFF par défaut)
# ENABLE_CALLBACK_COMPLIANCE=1

# ---------------------------------------------------------------------------
# Transmission des demandes vers le CRM
#
# Tant que CRM_SYNC_ENABLED ne vaut pas 1, aucune demande ne quitte le site :
# elles s'accumulent dans data/crm-outbox.json et restent consultables dans
# l'administration. Un drapeau activé sans configuration complète ne tente
# rien non plus.
#
# CRM_SYNC_SECRET est partagé avec le CRM, qui le retrouve dans son trousseau
# WEB_LEAD_KEYRING sous l'identifiant CRM_SYNC_KEY_ID. L'appel est de serveur à
# serveur : ce secret ne doit jamais apparaître dans une page publique.
# ---------------------------------------------------------------------------
# CRM_SYNC_ENABLED=1
# CRM_SYNC_URL=https://crm.mkl-energies.fr/api/web-leads
# CRM_SYNC_KEY_ID=k1
# CRM_SYNC_SECRET=secret-aleatoire-de-32-caracteres-minimum
